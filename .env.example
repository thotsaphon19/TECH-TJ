# ---------- ฐานข้อมูล Neon (Postgres) ----------
# ไปที่ https://neon.tech -> สร้างโปรเจกต์ -> Dashboard -> Connection string
# แนะนำให้ใช้ "Pooled connection" (มีคำว่า -pooler ในชื่อ host) เพราะเหมาะกับ serverless ของ Vercel
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ---------- เซิร์ฟเวอร์ / ผู้ดูแลระบบ ----------
JWT_SECRET=change-this-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123
PORT=3000

# ---------- Supabase Realtime (แจ้งเตือนแชทแบบทันที ไม่ต้องรอ polling) ----------
# ไปที่ https://supabase.com -> สร้างโปรเจกต์ฟรี -> Project Settings -> API
# ใช้แค่ Project URL กับ anon public key (ปลอดภัยที่จะเปิดเผยฝั่ง browser)
# หมายเหตุ: Neon ยังเป็นฐานข้อมูลหลักเหมือนเดิม Supabase ใช้เฉพาะช่องทาง Realtime เท่านั้น
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---------- Cloudinary (เก็บรูปที่อัปโหลดจากหลังบ้าน) ----------
# ไปที่ https://cloudinary.com -> สมัครฟรี -> Dashboard จะโชว์ 3 ค่านี้ให้คัดลอก
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- LINE Official Account (LINE Messaging API) ----------
# ไปที่ https://developers.line.biz/console/ -> สร้าง Provider/Channel (Messaging API)
# Channel access token: หน้า Messaging API ของ Channel -> Issue
# Channel secret: หน้า Basic settings
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# LINE userId ของแอดมิน/ร้าน ที่จะให้ระบบส่งข้อความแจ้งเตือนเข้าไป
# หาได้จาก log ใน Vercel (Deployments -> Functions -> Logs) เมื่อแอดมินทักไลน์ OA ครั้งแรก
LINE_ADMIN_USER_ID=

# ---------- อีเมล (SMTP) ----------
# ตัวอย่าง Gmail: ต้องสร้าง App Password ที่ https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM="TECH-TJ <your@gmail.com>"
MAIL_TO=your@gmail.com
